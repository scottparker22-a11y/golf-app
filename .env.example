# Supabase — create a project at supabase.com, run supabase/schema.sql
# in the SQL editor, then paste your project's values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never sent to the browser.
# From Supabase dashboard → Project Settings → API → service_role key.
# Used by app/api/admin/* routes to write to admin-gated tables after
# verifying the admin PIN session cookie (see lib/adminAuth.ts) — RLS
# blocks the anon key from writing to those tables directly.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — random secret for signing the admin PIN session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional — powers the course/tee autofill on the Rounds setup step.
# Sign up at golfapi.io (or swap in another course-data provider) and
# drop the key in. Without it, course/hole entry just stays manual.
GOLF_COURSE_API_KEY=
